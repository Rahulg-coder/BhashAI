# BhashAI Environment Configuration
# Copy this file to .env and adjust values as needed.

# Application Settings
APP_NAME=BhashAI
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (comma-separated, * for dev)
ALLOWED_ORIGINS=*

# Supported Target Tribal Languages
DEFAULT_LANGUAGE=santhali
SUPPORTED_LANGUAGES=santhali,mundari,ho

# Model Configuration & Cache
ASR_MODEL_NAME=small
MODEL_CACHE_DIR=./models/cache

# Database (Future Phase)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/bhashai?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=bhashai
